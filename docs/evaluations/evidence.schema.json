{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FanxinSun/lmsluice/blob/codex/portable-device-readiness/docs/evaluations/evidence.schema.json",
  "title": "lmsluice portable-device campaign evidence",
  "type": "object",
  "required": ["schema", "case", "status", "required", "recorded_at_utc"],
  "properties": {
    "schema": {"const": 1},
    "case": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "FAIL", "SKIP", "NOT_RUN", "INCONCLUSIVE"]},
    "required": {"type": "boolean"},
    "recorded_at_utc": {"type": "string", "minLength": 1},
    "record": {"type": "string"},
    "error": {"type": ["object", "null"]},
    "evidence_class": {"type": "string"},
    "availability": {"type": "string"},
    "note": {"type": "string"}
  },
  "additionalProperties": true
}
